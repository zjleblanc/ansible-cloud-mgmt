# {{ ansible_managed }}
# Managed by the cloud.apps.redis role — do not edit by hand.

bind {{ redis_bind }}
port {{ redis_port }}
protected-mode yes
supervised systemd

dir /var/lib/redis
logfile /var/log/redis/redis.log
pidfile /var/run/redis/redis.pid

maxmemory {{ redis_maxmemory }}
maxmemory-policy {{ redis_maxmemory_policy }}

appendonly yes
appendfilename "appendonly.aof"

save 900 1
save 300 10
save 60 10000
